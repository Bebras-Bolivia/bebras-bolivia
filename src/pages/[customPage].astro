---
import StandardContentPage from "@/components/StandardContentPage.astro";
import customPagesData from "@/data/custom-pages.json";

interface CustomPage {
  id: string;
  title: string;
  slug: string;
  header: {
    tag: string;
    heading: string;
    subtitle: string;
  };
  components: any[];
}

export function getStaticPaths() {
  return (customPagesData.pages as CustomPage[]).map((page) => ({
    params: { customPage: page.slug },
  }));
}

const page = (customPagesData.pages as CustomPage[]).find(
  (item) => item.slug === Astro.params.customPage,
);
if (!page) throw new Error(`Página personalizada no encontrada: ${Astro.params.customPage}`);
---

<StandardContentPage
  title={page.title}
  description={page.header.subtitle}
  header={page.header}
  components={page.components}
/>
