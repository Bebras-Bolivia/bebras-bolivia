---
import Layout from "@/layouts/Layout.astro";
import InternalPageHero from "@/components/InternalPageHero.astro";
import PageComponentsRenderer from "@/components/PageComponentsRenderer.astro";
import data from "@/data/registro.json";
import { toSafeHref } from "@/lib/safe-url";
import { registrationHref } from "@/lib/registration";

const components: any[] = Array.isArray((data as any).components) ? (data as any).components : [];
const registration = (data as any).registration;
const openHref = registrationHref();
const open = Boolean(openHref);
const heading = open ? registration.openHeading || data.heading : data.heading;
const paragraph = open ? registration.openParagraph || data.paragraph : data.paragraph;
---

<Layout title={(data as any).pageTitle || heading} description={(data as any).pageDescription || paragraph}>
  {open && <script is:inline define:vars={{ target: openHref }}>location.replace(target);</script>}
  <InternalPageHero tag={data.tag} heading={heading} description={paragraph} />

  <section class="relative bg-bebras-paper py-16 lg:py-20 dark:bg-zinc-950">
    <div class="absolute inset-0 bg-dot-pattern opacity-30" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-lg px-4 sm:px-6 lg:px-8 text-center">
      <!-- Icon -->
      <div class="flex justify-center mb-5">
        {
          open ? (
            <div class="flex items-center justify-center size-20 rounded-full border-2 border-bebras-green/30 bg-bebras-green/10 text-bebras-green">
              <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
          ) : (
            <div class="flex items-center justify-center size-20 rounded-full border-2 border-primary/30 bg-primary/10 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
          )
        }
      </div>

      <div class="mt-7 flex flex-col sm:flex-row gap-3 justify-center">
        {
          open ? (
            <a
              href={openHref}
              class="group inline-flex items-center justify-center rounded-2xl bg-primary px-6 py-3.5 text-sm font-semibold text-primary-foreground transition-all duration-300 hover:-translate-y-0.5 hover:bg-primary/90"
            >
              {registration.openButton || "Inscribirme"}
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          ) : (
            <span
              class="inline-flex items-center justify-center rounded-2xl bg-primary/10 text-primary/50 px-6 py-3.5 text-sm font-semibold cursor-not-allowed border border-primary/20"
              aria-disabled="true"
            >
              {data.disabledButton}
            </span>
          )
        }
        <a
          href={toSafeHref(data.backButton.href)}
          class="group inline-flex items-center justify-center rounded-2xl border border-border bg-transparent px-6 py-3.5 text-sm font-semibold text-foreground transition-all duration-300 hover:border-primary/30 hover:text-primary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 transition-transform group-hover:-translate-x-1"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          {data.backButton.label}
        </a>
      </div>

      {!open && <div class="editorial-callout mt-8 px-6 py-5 text-left">
        <p class="text-xs uppercase tracking-[0.15em] font-semibold text-primary mb-2">{data.notification.tag}</p>
        <p class="text-sm text-foreground leading-relaxed">
          <strong>{data.notification.text}</strong> {data.notification.instruction}
          <a href={`mailto:${data.notification.email}`} class="text-primary hover:text-primary/80 underline underline-offset-2 font-medium">{data.notification.email}</a>
          {data.notification.suffix}
        </p>
      </div>}
    </div>
  </section>
  {components.length > 0 && <PageComponentsRenderer components={components} />}
</Layout>
