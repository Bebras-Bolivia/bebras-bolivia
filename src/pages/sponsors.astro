---
import StandardContentPage from "@/components/StandardContentPage.astro";
import data from "@/data/sponsors.json";

const sponsorsData = data as any;
const header = sponsorsData.header || {};
const components: any[] = Array.isArray(sponsorsData.components) ? sponsorsData.components : [];
---

<StandardContentPage
  title={header.pageTitle || header.heading}
  description={header.pageDescription || header.subtitle}
  {header}
  {components}
/>
