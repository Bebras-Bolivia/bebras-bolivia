---
import StandardContentPage from "@/components/StandardContentPage.astro";
import data from "@/data/estudiantes.json";

const header = data.header;
const components: any[] = Array.isArray((data as any).components) ? (data as any).components : [];
---

<StandardContentPage
  title="Prueba Mmarket - Estudiantes"
  description="Información para estudiantes sobre el Desafío Bebras Bolivia: cómo participar, categorías por edad y sistema de puntuación."
  {header}
  {components}
/>
