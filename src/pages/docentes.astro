---
import Layout from "@/layouts/Layout.astro";
import InternalPageHero from "@/components/InternalPageHero.astro";
import PageComponentsRenderer from "@/components/PageComponentsRenderer.astro";
import data from "@/data/docentes.json";

const header = data.header;
const components: any[] = Array.isArray((data as any).components) ? (data as any).components : [];
---

<Layout title={(data as any).pageTitle || header.heading} description={(data as any).pageDescription || header.subtitle}>
  <div class="relative w-full">
    <InternalPageHero tag={header.tag} heading={header.heading} description={header.subtitle} />

    <main class="relative z-10 w-full min-h-screen bg-bebras-paper dark:bg-zinc-950 pb-20 pt-10 lg:pt-14">
      <PageComponentsRenderer components={components} />
    </main>
  </div>
</Layout>

<script>
  import "@/scripts/reveal-sections";
</script>
