---
import StandardContentPage from "@/components/StandardContentPage.astro";
import faqData from "@/data/faq.json";

const faq = faqData as any;
const header = faq.header || { tag: "Ayuda", heading: "Preguntas frecuentes", subtitle: "" };
const components: any[] = Array.isArray(faq.components) ? faq.components : [];
---

<StandardContentPage
  title={header.pageTitle || header.heading}
  description={header.pageDescription || header.subtitle}
  {header}
  {components}
/>
