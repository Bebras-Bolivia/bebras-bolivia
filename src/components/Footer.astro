---
import navData from "@/data/navigation.json";
import siteData from "@/data/site.json";

const currentYear = new Date().getFullYear();
const { socialLinks } = navData;
const footer = (navData as { footer?: { copyrightText?: string; trademarkNote?: string; trademarkUrl?: string } }).footer;
const copyrightText = footer?.copyrightText ?? siteData.copyrightText;
const trademarkNote = footer?.trademarkNote ?? siteData.trademarkNote;
const trademarkUrl = footer?.trademarkUrl ?? siteData.trademarkUrl;

const socialIconMap: Record<string, string> = {
  facebook:
    '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />',
  instagram:
    '<rect width="20" height="20" x="2" y="2" rx="5" ry="5" /><path d="M16 11.37a4 4 0 1 1-7.75 1.26 4 4 0 0 1 7.75-1.26z" /><line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />',
  tiktok:
    '<path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" />',
  youtube:
    '<path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17" /><path d="m10 15 5-3-5-3z" />',
  twitter:
    '<path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z" />',
  x:
    '<path d="M4 4l16 16M20 4 4 20" />',
  email:
    '<rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />',
};

const socialColorMap: Record<string, string> = {
  facebook: "bg-bebras-green text-white",
  instagram: "bg-bebras-red text-white",
  tiktok: "bg-bebras-ink text-white",
  youtube: "bg-bebras-red text-white",
  twitter: "bg-bebras-blue text-white",
  x: "bg-bebras-ink text-white",
  email: "bg-bebras-yellow text-bebras-ink",
};
---

<footer class="relative z-10 w-full bg-bebras-paper dark:bg-zinc-950 border-t border-border/70">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-5">
    <div class="text-center sm:text-left">
      <p class="text-sm font-semibold text-foreground">
        &copy; {currentYear} {copyrightText}
      </p>
      <p class="text-xs text-muted-foreground mt-1">
        {trademarkNote} &mdash;
        <a
          href={trademarkUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-primary underline underline-offset-2"
        >
          bebras.org
        </a>
      </p>
    </div>

    <div class="flex flex-col items-center sm:items-end gap-3">
      <div class="flex gap-2">
        {socialLinks.map((link) => {
          const isMailto = link.href.startsWith("mailto:");
          return (
          <a
            href={link.href}
            aria-label={link.label}
            target={isMailto ? undefined : "_blank"}
            rel={isMailto ? undefined : "noopener noreferrer"}
            class:list={[
              "inline-flex items-center justify-center size-10 rounded-2xl hover:-translate-y-0.5 hover:shadow-md transition-all duration-200",
              socialColorMap[link.icon] ?? "bg-bebras-green text-white",
            ]}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={socialIconMap[link.icon] ?? socialIconMap.email}
            />
          </a>
          );
        })}
      </div>
    </div>
  </div>
</footer>
