---
import { getItemBrandCardClass, normalizeBrandColor } from "@/lib/brand-styles";
import { formatInlineRichText } from "@/lib/rich-text";

interface Item {
  title: string;
  desc: string;
  color?: string;
}

interface Props {
  tag?: string;
  heading?: string;
  intro?: string;
  columns?: number;
  items: Item[];
  outro?: string;
  accent?: string;
  cardPalette?: string[];
}

const { tag, heading, intro, columns = 2, items = [], outro, accent = "blue", cardPalette } = Astro.props;
const accentTextClass = `text-bebras-${normalizeBrandColor(accent)}`;

function getColsClass(cols: number) {
  if (cols <= 1) return "grid-cols-1";
  if (cols === 2) return "grid-cols-1 sm:grid-cols-2";
  if (cols === 3) return "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3";
  return "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4";
}
---

<section class="reveal-section w-full mx-auto max-w-6xl px-4 sm:px-6 mb-8 lg:mb-10">
  <div class="editorial-section">
    <div class="mx-auto max-w-6xl">
      {tag && <p class:list={["text-sm uppercase tracking-[0.25em] font-bold mb-4", accentTextClass]}>{tag}</p>}
      {heading && <h2 class="text-4xl sm:text-5xl font-bold text-foreground mb-8 tracking-tight">{heading}</h2>}
      <div class="space-y-4 text-xl text-muted-foreground leading-relaxed">
        {intro && <p class="max-w-5xl" set:html={formatInlineRichText(intro)} />}
        <ul class:list={["mt-8 grid gap-5", getColsClass(columns)]}>
          {items.map((item, i) => (
            <li class:list={["group flex min-h-44 items-start gap-5 overflow-hidden p-6 sm:p-7", getItemBrandCardClass(item.color, i, cardPalette)]}>
              <span class="brand-card-icon mt-0.5 flex size-12 shrink-0 items-center justify-center rounded-2xl font-mono text-base font-bold tabular-nums transition-transform duration-300 group-hover:scale-105">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="min-w-0 flex-1">
                <strong class="block text-2xl font-bold leading-tight sm:text-3xl">{item.title}</strong>
                <span class="brand-card-muted mt-3 block text-base leading-relaxed sm:text-lg">{item.desc}</span>
              </span>
            </li>
          ))}
        </ul>
        {outro && <p class="max-w-5xl pt-6 font-medium text-foreground/80" set:html={formatInlineRichText(outro)} />}
      </div>
    </div>
  </div>
</section>
